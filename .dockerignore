.vscode/
.idea/
.agents/
.codex/
.kilocode/
.kombai/
.qodo/
.qwen/

# --- Docs, tests & vagrant ---
docs/
tests/
vagrant/
*.md

# --- OS / misc dev files ---
.DS_Store
Thumbs.db
*.log
setup.bat
image.png
